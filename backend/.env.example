# ---- Database ----
# 默认使用本地 SQLite，零配置即可启动。
# 部署时切换到 PostgreSQL（如 Supabase 的 Connection string）：
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./tripai.db

# ---- Security ----
# 生产环境务必换成随机长字符串：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- LLM（OpenAI 兼容协议，三选一）----
# 1) DeepSeek 官方：base=https://api.deepseek.com/v1  model=deepseek-chat
# 2) 硅基流动（注册送 2000 万 tokens，0 成本）：base=https://api.siliconflow.cn/v1  model=deepseek-ai/DeepSeek-V3
# 3) 智谱 GLM-4-Flash（官方免费模型）：base=https://open.bigmodel.cn/api/paas/v4  model=glm-4-flash
# 留空 LLM_API_KEY 时，后端会自动返回示例行程（mock 模式），方便先跑通流程。
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=90

# ---- 高德地图 Web 服务 Key（后端 POI 搜索，个人开发者免费）----
# 申请：https://console.amap.com/dev/key/app
# 留空时 AI 行程会使用模型给出的近似坐标，地图依然可用。
AMAP_WEB_KEY=

